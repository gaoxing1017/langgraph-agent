# App
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM
LLM_PROVIDER=siliconflow
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
SILICONFLOW_API_KEY=sk-...
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3
DEFAULT_TEMPERATURE=0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_framework
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_NAME=agent_framework

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Nacos
NACOS_SERVER_ADDRESSES=127.0.0.1:8848
NACOS_NAMESPACE=dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_DATA_ID=agent-framework.yaml
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=agent-framework
NACOS_SERVICE_PORT=8000

# A2A
A2A_AGENT_NAME=agent-framework
A2A_AGENT_VERSION=1.0.0

# Memory
CHECKPOINTER_TYPE=memory
MAX_CONVERSATION_TURNS=50
MEMORY_SUMMARIZE_THRESHOLD=20

# Tavily (Search)
TAVILY_API_KEY=tvly-...

# Security
SECRET_KEY=change-me-in-production
